
---
import Navegacion from "../components/Navegacion.astro";

const { titulo = "Celeste Ochoa" } = Astro.props;
const url = new URL(Astro.url.pathname, "https://c8a.vercel.app");
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/png" href="/favicon.png" />

    <title>{titulo}</title>

    <!-- Vista previa al compartir -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Celeste Ochoa" />
    <meta property="og:title" content="Celeste Ochoa" />
    <meta
      property="og:description"
      content="Portafolio de Celeste Ochoa."
    />
    <meta
      property="og:image"
      content="https://c8a.vercel.app/vista-previa.jpg"
    />
    <meta property="og:url" content={url.href} />
    <meta property="og:locale" content="es_CO" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Celeste Ochoa" />
    <meta
      name="twitter:description"
      content="Portafolio de Celeste Ochoa."
    />
    <meta
      name="twitter:image"
      content="https://c8a.vercel.app/vista-previa.jpg"
    />
  </head>

  <body>
    <Navegacion />
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500&display=swap');

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    padding: 0;
    background: #ECE9E2;
    color: #292722;
    font-family: 'Montserrat', sans-serif;
    font-size: 12px;
    font-weight: 400;
  }

  a {
    color: inherit;
    text-decoration: none;
  }
</style>
