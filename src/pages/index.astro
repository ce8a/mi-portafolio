
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout titulo="Celeste Ochoa">
  <main class="inicio">
    <img
      class="personaje"
      src="/imagenes/movil/inicio1.jpg"
      alt="Mariquita"
    />
  </main>
</BaseLayout>

<style>
  .inicio {
    min-height: 100vh;
  }

  .personaje {
    display: none;
  }

  @media (max-width: 600px) {
    .inicio {
      min-height: calc(100vh - 100px);
      display: flex;
      justify-content: center;
      align-items: center;
      transform: translateY(-20px);
      padding: 24px;
    }

    .personaje {
      display: block;
      width: 65%;
      max-width: 260px;
      height: auto;
      object-fit: contain;
    }
  }
</style>

<script>
  const personaje = document.querySelector(".personaje");

  if (personaje) {
    const imagenes = [
      "/imagenes/movil/inicio1.jpg",
      "/imagenes/movil/inicio2.jpg",
      "/imagenes/movil/inicio3.jpg",
      "/imagenes/movil/inicio4.jpg"
    ];

    let indice = 0;

    setInterval(() => {
      indice = (indice + 1) % imagenes.length;
      personaje.src = imagenes[indice];
    }, 500);
  }
</script>
